{
  "name": "english-materials-checks",
  "private": true,
  "description": "english-materials 站点的 HTML 校验与 Lighthouse 性能检查（仅 CI 使用）",
  "scripts": {
    "htmlvalidate": "html-validate \"**/*.html\"",
    "lighthouse": "lhci autorun",
    "extract:g7a": "node scripts/extract-g7a.mjs",
    "test:extract": "node --test \"scripts/*.test.mjs\"",
    "dev:app": "npm --prefix app-src run dev",
    "build:app": "npm --prefix app-src run build",
    "test:app": "npm --prefix app-src run test"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@lhci/cli": ">=0.14.0",
    "html-validate": ">=9.0.0"
  }
}
